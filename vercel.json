{
  "version": 2,
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/",
      "dest": "/api/index"
    },
    {
      "src": "/album",
      "dest": "/api/album"
    },
    {
      "src": "/album\\.html",
      "dest": "/api/album"
    },
    {
      "src": "/events",
      "dest": "/api/events"
    },
    {
      "src": "/events\\.html",
      "dest": "/api/events"
    },
    {
      "src": "/studio",
      "dest": "/api/studio"
    },
    {
      "src": "/studio\\.html",
      "dest": "/api/studio"
    },
    {
      "src": "/outdoor",
      "dest": "/api/outdoor"
    },
    {
      "src": "/outdoor\\.html",
      "dest": "/api/outdoor"
    },
    {
      "src": "/collabs",
      "dest": "/api/collabs"
    },
    {
      "src": "/collabs\\.html",
      "dest": "/api/collabs"
    },
    {
      "src": "/(.*)\\.html",
      "dest": "/public/$1.html"
    },
    {
      "src": "/(.+)",
      "dest": "/public/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
