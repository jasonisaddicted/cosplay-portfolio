{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "FIREBASE_CREDENTIALS": "@firebase_credentials",
    "FIREBASE_PROJECT_ID": "@firebase_project_id"
  }
}
