{
  "version": 2,
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/",
      "dest": "/api/index"
    },
    {
      "src": "/album\\.html",
      "dest": "/api/album"
    },
    {
      "src": "/((?!album)[^/]*)\\.html",
      "dest": "/public/$1.html"
    },
    {
      "src": "/album(?:\\?|$)",
      "dest": "/api/album"
    },
    {
      "src": "/photo(?:\\?|$)",
      "dest": "/api/photo"
    },
    {
      "src": "/events(?:\\?|$)",
      "dest": "/api/events"
    },
    {
      "src": "/studio(?:\\?|$)",
      "dest": "/api/studio"
    },
    {
      "src": "/outdoor(?:\\?|$)",
      "dest": "/api/outdoor"
    },
    {
      "src": "/collabs(?:\\?|$)",
      "dest": "/api/collabs"
    },
    {
      "src": "/(.+)",
      "dest": "/public/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/og-thumbnails/(.*)\\.jpg$",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
