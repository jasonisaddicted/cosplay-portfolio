{
  "hosting": [
    {
      "target": "cosplay-portfolio",
      "public": ".next/standalone/public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        ".DS_Store",
        "README.md"
      ],
      "rewrites": [
        {
          "source": "**",
          "function": "nextjsFunction"
        }
      ],
      "cleanUrls": true
    }
  ],
  "functions": {
    "source": ".next/standalone",
    "runtime": "nodejs20",
    "codebase": "default"
  }
}
